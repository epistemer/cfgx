# M8.3: cfgx init in an empty directory gives a program that builds and
# runs with no edits.
go build -o cfgx$exe github.com/epistemer/cfgx/cmd/cfgx
mkdir hello
cd hello
exec ../cfgx$exe init -cfgx $CFGX_ROOT example.com/hello
stdout '^Created example.com/hello\. Next: \./hello serve\r?$'
exists hello$exe
exists go.mod go.sum .gitignore README.md main.go serve.go internal/settings/zz_settings.go internal/logging/logging.go
exists hello.example.yaml hello.schema.json docs/CONFIG.md cfgx.lock.json
grep '^tool github.com/epistemer/cfgx/cmd/cfgx$' go.mod

go build -o hello$exe .
exec ./hello$exe serve --help
stdout '--server-addr string'
stdout '--log-level string'
stdout '--config path'
exec ./hello$exe config explain
stdout '^server.addr\s+localhost:8080\s+default\s+localhost:8080\r?$'
stdout '^log.level\s+info\s+default'
exec ./hello$exe version
stdout .

# cfgx's warnings go through the logrus logger.
cp ../files/hello.yaml hello.yaml
exec ./hello$exe config explain
stderr 'level=warning msg="unknown key \\"servr\\" in hello.yaml:1:1; did you mean \\"server\\"\?"'

# So do libraries that log through slog.Default, such as auth and handlers.
cp ../files/slog_test.go slog_test.go
go test -run TestSlogDefault -v .
stdout 'level=info msg="from a library" k=1'

# A second init refuses, and changes nothing.
! exec ../cfgx$exe init example.com/hello
stderr 'refusing to overwrite go.mod, go.sum, internal/settings/zz_settings.go, hello.example.yaml'

# A refused name writes nothing.
! exec ../cfgx$exe init -name Bad example.com/x
stderr 'cfgx init: -name "Bad" must match'

# A second run in a new directory with -name sets the app name.
cd ..
mkdir confab
cd confab
exec ../cfgx$exe init -cfgx $CFGX_ROOT -name confab example.com/example
stdout '^Created example.com/example\. Next: \./confab serve\r?$'
exists confab$exe
exists confab.example.yaml confab.schema.json
exec ./confab$exe config explain
stdout '^server.addr\s+localhost:8080\s+default'
exec ./confab$exe config env
stdout 'CONFAB_SERVER_ADDR'

-- files/hello.yaml --
servr:
  addr: ":9090"
-- files/slog_test.go --
package main

import (
	"log/slog"
	"os"
	"testing"
)

// main sets slog's default logger; version is a command that loads nothing.
func TestSlogDefault(t *testing.T) {
	os.Args = []string{"hello", "version"}
	main()
	slog.Info("from a library", "k", 1)
}
