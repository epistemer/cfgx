# M4.4: Secret and SecretFile keys. A Secret has no flag, and also reads
# <ENV>_FILE; a SecretFile reads the file its setting names, only when the key
# is loaded and relevant. Messages never show a secret.
# testscript can't unset a variable, so the steps that set env vars are ordered.
go generate ./...
go build -o app$exe .

# A Secret is never a flag; a SecretFile's path is.
exec ./app$exe serve --help
! stdout 'db-password'
stdout '--tls-key file\s+TLS private key \(default "ssl/key.pem"\)'
! exec ./app$exe serve --db-password x
stderr 'unknown flag: --db-password'
! exec ./app$exe serve
stderr '^  db.password: is required; set APP_DB_PASSWORD, APP_DB_PASSWORD_FILE or db.password in the config file\r?$'

# The config file can hold a Secret.
cp files/pw.yaml app.yaml
exec ./app$exe migrate
stdout '^migrate pw=from-yaml\r?\n$'
rm app.yaml

# _FILE loses one trailing newline, \r\n or \n, and no more.
writebytes pw.txt 'from-file\r\n'
env APP_DB_PASSWORD_FILE=pw.txt
exec ./app$exe serve
stdout '^pw="from-file" masked=\*\*\*\*\*\* '
! stderr .
writebytes pw.txt 'two\n\n'
exec ./app$exe serve
stdout '^pw="two\\n" '

# The file must exist, be a regular file, and hold at most 1 MiB.
env APP_DB_PASSWORD_FILE=missing.txt
! exec ./app$exe serve
stderr '^  db.password: missing.txt doesn''t exist \(env APP_DB_PASSWORD_FILE\)\r?$'
writebytes big.txt x 1048577
env APP_DB_PASSWORD_FILE=big.txt
! exec ./app$exe serve
stderr '^  db.password: big.txt is larger than 1MiB \(env APP_DB_PASSWORD_FILE\)\r?$'
writebytes big.txt x 1048576
exec ./app$exe serve
[unix] mkfifo fifo
[unix] env APP_DB_PASSWORD_FILE=fifo
[unix] ! exec ./app$exe serve
[unix] stderr '^  db.password: fifo isn''t a regular file \(env APP_DB_PASSWORD_FILE\)\r?$'

# Setting both is an error; an empty _FILE names no file, so it doesn't count.
env APP_DB_PASSWORD_FILE=pw.txt
env APP_DB_PASSWORD=hunter2
! exec ./app$exe serve
stderr '^  db.password: APP_DB_PASSWORD and APP_DB_PASSWORD_FILE are both set; set one \(env APP_DB_PASSWORD\)\r?$'
env APP_DB_PASSWORD_FILE=
exec ./app$exe serve
stdout '^pw="hunter2" masked=\*\*\*\*\*\* token="" keys="" tls=false key=""\r?\n$'
! stderr .

# TLS is off and ssl/key.pem doesn't exist: RelevantIf skips the read. A key
# path that is set warns that it's ignored, and isn't read either.
exec ./app$exe serve --tls-key nowhere.pem
stderr '^warning: server.tls.key is set \(flag --tls-key\) but ignored: it only matters when server.tls.enabled is set\r?$'
! stderr 'nowhere.pem doesn'

# With TLS on, the default path is read, and must exist.
! exec ./app$exe serve --tls-enabled
stderr '^  server.tls.key: ssl[/\\]key.pem doesn''t exist \(default\)\r?$'
mkdir ssl
writebytes ssl/key.pem 'PEM\n'
exec ./app$exe serve --tls-enabled
stdout 'tls=true key="PEM\\n"'

# A relative SecretFile path in the config file is relative to its directory,
# and the contents are kept exactly.
mkdir conf
cp files/app.yaml conf/app.yaml
writebytes conf/keys.csv 'k1,k2\n'
exec ./app$exe serve --config conf/app.yaml
stdout 'keys="k1,k2\\n"'

# Problems name sources, never values.
env APP_AUTH_TOKEN=hunter2-token
! exec ./app$exe serve --config conf/app.yaml
stderr '^  auth: token and keys are mutually exclusive \(token: env APP_AUTH_TOKEN, keys: conf[/\\]app.yaml:2:9\)\r?$'
! stderr hunter2

-- files/app.yaml --
auth:
  keys: keys.csv
-- files/pw.yaml --
db:
  password: from-yaml
-- main.go --
package main

import (
	"context"
	"fmt"
	"os"

	"github.com/spf13/cobra"

	"example.com/e2e/internal/settings"
)

func main() {
	root := &cobra.Command{Use: "app"}
	settings.BindRoot(root)
	root.AddCommand(
		settings.ServeCommand(&cobra.Command{Use: "serve"},
			func(_ context.Context, s *settings.Serve) error {
				fmt.Printf("pw=%q masked=%v token=%q keys=%q tls=%t key=%q\n",
					s.DBPassword().Reveal(), s.DBPassword(), s.AuthToken().Reveal(), s.AuthKeys().Reveal(),
					s.ServerTLSEnabled(), s.ServerTLSKey().Reveal())
				return nil
			}),
		settings.MigrateCommand(&cobra.Command{Use: "migrate"},
			func(_ context.Context, m *settings.Migrate) error {
				fmt.Printf("migrate pw=%s\n", m.DBPassword().Reveal())
				return nil
			}),
	)
	if err := root.Execute(); err != nil {
		os.Exit(1)
	}
}
-- internal/settings/settings.go --
package settings

//go:generate go run github.com/epistemer/cfgx/cmd/cfgx gen ./schema
-- internal/settings/schema/schema.go --
package schema

import "github.com/epistemer/cfgx/dsl"

var DB = dsl.Group("db", "Database",
	dsl.Secret("password", "Database password").Required(),
)

var (
	apiToken = dsl.Secret("token", "Static API token")
	apiKeys  = dsl.SecretFile("keys", "API keys file")
)

var Auth = dsl.Group("auth", "Authentication", apiToken, apiKeys).
	Rules(dsl.AtMostOne(apiToken, apiKeys))

var (
	tlsEnabled = dsl.Bool("tls.enabled", "Serve HTTPS")
	tlsKey     = dsl.SecretFile("tls.key", "TLS private key").Default("ssl/key.pem")
)

var Server = dsl.Group("server", "HTTP server", tlsEnabled, tlsKey).
	FlagPrefix("").
	Rules(dsl.RelevantIf(tlsKey, tlsEnabled))

var App = dsl.App("app", "Test app", DB, Auth, Server).ConfigFile("app", ".")

var (
	Serve   = dsl.Command("Serve").Uses(DB, Auth, Server)
	Migrate = dsl.Command("Migrate").Uses(DB)
)
