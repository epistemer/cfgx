# M7.1: the store's lifecycle. A command with a mutable key, or WithStore,
# opens the file the App.Store key names while loading, and closes it after
# run. Commands without the store never touch it. A second process waits
# for the lock, then says the store is held.
go generate ./...
go build -o app$exe .

# migrate has no mutable key: no file.
exec ./app$exe migrate
! exists data/app.db

# config explain opens the store read-only and never creates it (M7.8).
mkdir data
exec ./app$exe config explain
stdout '^rate.limit\s+100\s+default\s+100\r?$'
! stderr .
! exists data/app.db

# serve has a mutable key: it opens (and creates) the file. The store key's
# directory must exist, as for any path.
exec ./app$exe serve
stdout '^served\r?$'
exists data/app.db

# admin asked for the store with WithStore; the key's flag is bound for it,
# and the path from the config file is relative to the file.
mkdir conf
cp files/app.yaml conf/app.yaml
exec ./app$exe admin --config conf/app.yaml
exists conf/store.db
exec ./app$exe admin --storage-bolt other.db
exists other.db

# While one process holds the store, another waits a second, then gives up.
# config explain carries on without stored values, and says so.
exec ./app$exe serve --hold 5s &
sleep 1s
! exec ./app$exe serve
stderr 'data[/\\]app.db: store is held by a running process; change settings through the application'
exec ./app$exe config explain
stderr '^warning: showing values without the store: .*store is held by a running process'
stdout '^rate.limit\s+100\s+default'
wait

# serve writes through the generated Update: the value is stored with its
# history, the getter and OnChange see it, and the next run loads it.
exec ./app$exe serve --set 250
stdout '^changed \[rate.limit\] to 250\r?$'
stdout '^limit 250\r?$'
exec ./app$exe serve
stdout '^limit 250\r?$'
! exec ./app$exe serve --set -1
stderr 'rate.limit: must be at least 1'

# explain shows who stored the value, when, and the env var it hides; the
# program warns about the shadowed env var at startup.
env APP_RATE_LIMIT=120
exec ./app$exe config explain
stdout '^rate.limit\s+250\s+store \(\d{4}-\d\d-\d\d, e2e\), hides env APP_RATE_LIMIT\s+100\r?$'
exec ./app$exe serve
stderr 'rate.limit: stored value 250 \(e2e, \d{4}-\d\d-\d\d\) overrides env APP_RATE_LIMIT=120'

# A reset brings the env value back.
exec ./app$exe serve --reset
stdout '^limit 120\r?$'

# The admin API lists the command's keys, and LoadServe opens the store.
exec ./app$exe admin --list
stdout '^db.host=localhost \(default\)\r?$'
exec ./app$exe load
stdout '^loaded limit 120, history 2\r?$'

# An empty store key means there's no file to open.
env APP_STORAGE_BOLT=
! exec ./app$exe serve
stderr 'storage.bolt is empty, so there is no store file'

-- files/app.yaml --
storage:
  bolt: store.db
-- main.go --
package main

import (
	"context"
	"fmt"
	"os"
	"time"

	"github.com/spf13/cobra"

	"github.com/epistemer/cfgx"

	"example.com/e2e/internal/settings"
)

func main() {
	root := &cobra.Command{Use: "app"}
	settings.BindRoot(root)
	var hold time.Duration
	var set int
	var reset, list bool
	serve := settings.ServeCommand(&cobra.Command{Use: "serve"},
		func(ctx context.Context, s *settings.Serve) error {
			time.Sleep(hold)
			s.OnChange(func(c settings.Change) {
				if c.Has(settings.KeyRateLimit) {
					fmt.Println("changed", c.Keys(), "to", s.RateLimit())
				}
			})
			switch {
			case set != 0:
				if err := s.Update(ctx, func(u *settings.Update) error {
					u.SetRateLimit(set)
					return nil
				}, cfgx.By("e2e")); err != nil {
					return err
				}
			case reset:
				if err := s.Update(ctx, func(u *settings.Update) error {
					u.ResetRateLimit()
					return nil
				}); err != nil {
					return err
				}
			}
			if hold == 0 {
				fmt.Println("limit", s.RateLimit())
			}
			fmt.Println("served")
			return nil
		})
	serve.Flags().DurationVar(&hold, "hold", 0, "hold the store this long")
	serve.Flags().IntVar(&set, "set", 0, "set rate.limit")
	serve.Flags().BoolVar(&reset, "reset", false, "reset rate.limit")
	admin := settings.AdminCommand(&cobra.Command{Use: "admin"}, func(_ context.Context, a *settings.Admin) error {
		if list {
			for _, st := range a.Store().List() {
				fmt.Printf("%s=%s (%s)\n", st.Key, st.Value, st.Source)
			}
		}
		return nil
	})
	admin.Flags().BoolVar(&list, "list", false, "list the settings")
	load := &cobra.Command{Use: "load", RunE: func(cmd *cobra.Command, _ []string) error {
		s, err := settings.LoadServe(cmd.Context())
		if err != nil {
			return err
		}
		defer s.Close()
		h, err := s.Store().History("rate.limit", 0)
		if err != nil {
			return err
		}
		fmt.Printf("loaded limit %d, history %d\n", s.RateLimit(), len(h))
		return nil
	}}
	root.AddCommand(serve, load, admin, settings.ConfigCommand(),
		settings.MigrateCommand(&cobra.Command{Use: "migrate"}, func(context.Context, *settings.Migrate) error { return nil }),
	)
	if err := root.Execute(); err != nil {
		os.Exit(1)
	}
}
-- internal/settings/settings.go --
package settings

//go:generate go run github.com/epistemer/cfgx/cmd/cfgx gen ./schema
-- internal/settings/schema/schema.go --
package schema

import "github.com/epistemer/cfgx/dsl"

var bolt = dsl.Path("bolt", "Store file").Default("data/app.db")

var Storage = dsl.Group("storage", "Storage", bolt)

var Rate = dsl.Group("rate", "Rate limits",
	dsl.Int("limit", "Requests per second").Default(100).Min(1).Mutable(),
)

var DB = dsl.Group("db", "Database", dsl.String("host", "Host").Default("localhost"))

var App = dsl.App("app", "Test app", Storage, Rate, DB).ConfigFile("app", ".").Store(bolt)

var (
	Serve   = dsl.Command("Serve").Uses(Rate)
	Migrate = dsl.Command("Migrate").Uses(DB)
	Admin   = dsl.Command("Admin").Uses(DB).WithStore()
)
