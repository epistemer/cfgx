package schema

import "github.com/epistemer/cfgx/dsl"

var DB = dsl.Group("database", "Database",
	dsl.String("host", "Host").Default("localhost"),
	dsl.String("name", "Name").Default("app"),
).GoName("DB").Computed("DSN", "Missing")

var Scheduler = dsl.Group("scheduler", "Scheduler",
	dsl.Int("retry_seconds", "Retry delay").Default(3),
).Computed("RetryPolicy")

var App = dsl.App("app", "Test app", DB, Scheduler)

var Serve = dsl.Command("Serve").Uses(DB, Scheduler)
