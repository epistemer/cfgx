# kinds: environment variables.
# Generated by cfgx from the schema; don't edit. Each is commented out at
# its default.

# The config file to read, instead of searching for config.yaml.
# K_CONFIG=

# string.
# Key k.s, flag --k-s. Used by Run.
# K_K_S=x

# bool.
# Key k.b, flag --k-b. Used by Run.
# K_K_B=true

# int.
# Key k.i, flag --k-i. Used by Run.
# K_K_I=-3

# int64.
# Key k.i64, flag --k-i64. Used by Run.
# K_K_I64=9223372036854775807

# uint.
# Key k.u, flag --k-u. Used by Run.
# K_K_U=7

# float.
# Key k.f, flag --k-f. Used by Run.
# K_K_F=0.25

# duration.
# Key k.d, flag --k-d. Used by Run.
# K_K_D=5m0s

# odd duration.
# Key k.d2, flag --k-d2. Used by Run.
# K_K_D2=1.5s

# bytesize.
# Key k.size, flag --k-size. Used by Run.
# K_K_SIZE=1MiB

# no default.
# Key k.none, flag --k-none. Used by Run.
# K_K_NONE=

# path.
# Key k.path, flag --k-path. Used by Run.
# K_K_PATH=data//app.db

# file.
# Key k.file, flag --k-file. Used by Run.
# K_K_FILE=ca.pem

# url.
# Key k.url, flag --k-url. Used by Run.
# K_K_URL=https://example.com/x

# location.
# Key k.loc, flag --k-loc. Used by Run.
# K_K_LOC=UTC

# url without default.
# Key k.url2, flag --k-url2. Used by Run.
# K_K_URL2=

# strings.
# Key k.tags, flag --k-tags. Used by Run.
# K_K_TAGS="a,\"b,c\",\"\""

# ints.
# Key k.ports, flag --k-ports. Used by Run.
# K_K_PORTS="80, 443"

# durations.
# Key k.backoff, flag --k-backoff. Used by Run.
# K_K_BACKOFF=1000ms,1m

# stringmap.
# Key k.labels, flag --k-labels. Used by Run.
# K_K_LABELS=b=2,a=x=y

# empty list.
# Key k.none2, flag --k-none2. Used by Run.
# K_K_NONE2=

# text.
# Key k.cidr, flag --k-cidr. Used by Run.
# K_K_CIDR=10.0.0.0/8

# checked int.
# Key k.port, flag --k-port. Used by Run.
# K_K_PORT=80

# checked string.
# Key k.name, flag --k-name. Used by Run.
# K_K_NAME=

# computed default.
# Default: from runtime.NumCPU.
# Key k.cpus, flag --k-cpus. Used by Run.
# K_K_CPUS=

# checked duration.
# Key k.wait, flag --k-wait. Used by Run.
# K_K_WAIT=

# directory.
# Key k.dir, flag --k-dir. Used by Run.
# K_K_DIR=

# env only, renamed in the file.
