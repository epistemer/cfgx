{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Kinds",
  "properties": {
    "k": {
      "additionalProperties": false,
      "description": "Every kind",
      "properties": {
        "b": {
          "default": true,
          "description": "bool",
          "type": [
            "boolean",
            "null"
          ]
        },
        "backoff": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "pattern": "^([-+]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|ms|s|m|h))+$|^0$",
                    "type": "string"
                  },
                  {
                    "const": 0
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": [
            "1s",
            "1m0s"
          ],
          "description": "durations"
        },
        "cidr": {
          "default": "10.0.0.0/8",
          "description": "text",
          "type": [
            "string",
            "null"
          ]
        },
        "cpus": {
          "description": "computed default",
          "type": [
            "integer",
            "null"
          ]
        },
        "d": {
          "anyOf": [
            {
              "pattern": "^([-+]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|ms|s|m|h))+$|^0$",
              "type": "string"
            },
            {
              "const": 0
            },
            {
              "type": "null"
            }
          ],
          "default": "5m0s",
          "description": "duration"
        },
        "d2": {
          "anyOf": [
            {
              "pattern": "^([-+]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|ms|s|m|h))+$|^0$",
              "type": "string"
            },
            {
              "const": 0
            },
            {
              "type": "null"
            }
          ],
          "default": "1.5s",
          "description": "odd duration"
        },
        "dir": {
          "description": "directory",
          "type": [
            "string",
            "null"
          ]
        },
        "f": {
          "default": 0.25,
          "description": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "file": {
          "default": "ca.pem",
          "description": "file",
          "type": [
            "string",
            "null"
          ]
        },
        "i": {
          "default": -3,
          "description": "int",
          "type": [
            "integer",
            "null"
          ]
        },
        "i64": {
          "default": 9223372036854775807,
          "description": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "labels": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "type": "object"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": {
            "a": "x=y",
            "b": "2"
          },
          "description": "stringmap"
        },
        "loc": {
          "default": "UTC",
          "description": "location",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "checked string",
          "maxLength": 8,
          "minLength": 1,
          "pattern": "^(?:[a-z]+)$",
          "type": [
            "string",
            "null"
          ]
        },
        "nm": {
          "description": "renamed",
          "type": [
            "string",
            "null"
          ]
        },
        "none": {
          "anyOf": [
            {
              "pattern": "^([-+]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|ms|s|m|h))+$|^0$",
              "type": "string"
            },
            {
              "const": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "no default"
        },
        "none2": {
          "anyOf": [
            {
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "type": "array"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "empty list"
        },
        "path": {
          "default": "data//app.db",
          "description": "path",
          "type": [
            "string",
            "null"
          ]
        },
        "port": {
          "default": 80,
          "description": "checked int",
          "maximum": 65535,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "ports": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": [
            80,
            443
          ],
          "description": "ints"
        },
        "s": {
          "default": "x",
          "description": "string",
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^\\s*[0-9]+\\s*([bB]|[kKmMgGtTpP][iI]?[bB])?\\s*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "1MiB",
          "description": "bytesize"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "type": "array"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": [
            "a",
            "b,c",
            ""
          ],
          "description": "strings"
        },
        "u": {
          "default": 7,
          "description": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "url": {
          "default": "https://example.com/x",
          "description": "url",
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        },
        "url2": {
          "description": "url without default",
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        },
        "wait": {
          "anyOf": [
            {
              "pattern": "^([-+]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|ms|s|m|h))+$|^0$",
              "type": "string"
            },
            {
              "const": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "checked duration"
        }
      },
      "type": "object"
    }
  },
  "title": "kinds configuration",
  "type": "object"
}
