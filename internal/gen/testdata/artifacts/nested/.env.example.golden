# zp: environment variables.
# Generated by cfgx from the schema; don't edit. Each is commented out at
# its default.

# The config file to read, instead of searching for config.yaml.
# ZP_CONFIG=

# Host.
# Deprecated: use host instead.
# Key database.host, flag --database-host. Used by Serve.
# ZP_DATABASE_HOST=

# Port.
# Key server.port, flag --port. Used by Serve.
# ZP_SERVER_PORT=7777

# Serve HTTPS.
# Key server.tls.enabled, flag --tls-enabled. Used by Serve.
# ZP_SERVER_TLS_ENABLED=

# TLS certificate.
# Key server.tls.cert, flag --tls-cert. Used by Serve.
# ZP_SERVER_TLS_CERT=cert.pem

# Workers.
# Key scheduler.workers, flag --scheduler-workers. Used by Serve.
# ZP_SCHEDULER_WORKERS=

# Maximum retries.
# Key scheduler.retry.max, flag --scheduler-retry-max. Used by Serve, Retry.
# ZP_SCHEDULER_RETRY_MAX=3

# OTP length.
# Key auth.otp.length, flag --auth-otp-length. Used by Serve.
# ZP_AUTH_OTP_LENGTH=

# Sender address for auth emails.
# Key auth.emailfrom, flag --auth-emailfrom. Used by Serve, TestEmail, Notify.
# ZP_AUTH_EMAILFROM=

# Static API token.
# Key auth.token, flag --auth-token. Used by Serve.
# ZP_AUTH_TOKEN=

# API keys file.
# Key auth.keys, flag --auth-keys. Used by Serve.
# ZP_AUTH_KEYS=

# SMTP server host.
# Key smtp.host, flag --smtp-host. Used by Serve, TestEmail, Notify.
# ZP_SMTP_HOST=

# SMTP server port.
# Key smtp.port, flag --smtp-port. Used by Serve, TestEmail, Notify.
# ZP_SMTP_PORT=587

# Use implicit TLS.
# Key smtp.tls, flag --smtp-tls. Used by Serve, TestEmail, Notify.
# ZP_SMTP_TLS=
