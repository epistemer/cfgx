# zp: Nested.
# Generated by cfgx from the schema; don't edit. Every setting is commented
# out at its default: uncomment a line to change it.

# Database connection
database:
  # Host.
  # Deprecated: use host instead.
  # Env ZP_DATABASE_HOST, flag --database-host. Used by Serve.
  # host:

# HTTP server
server:
  # Port.
  # Env ZP_SERVER_PORT, flag --port. Used by Serve.
  # port: 7777

  tls:
    # Serve HTTPS.
    # Env ZP_SERVER_TLS_ENABLED, flag --tls-enabled. Used by Serve.
    # enabled:

    # TLS certificate.
    # Env ZP_SERVER_TLS_CERT, flag --tls-cert. Used by Serve.
    # cert: "cert.pem"

# Task scheduler
scheduler:
  # Workers.
  # Env ZP_SCHEDULER_WORKERS, flag --scheduler-workers. Used by Serve.
  # workers:

  # Retry policy
  retry:
    # Maximum retries.
    # Env ZP_SCHEDULER_RETRY_MAX, flag --scheduler-retry-max. Used by Serve, Retry.
    # max: 3

# Authentication
auth:

  otp:
    # OTP length.
    # Env ZP_AUTH_OTP_LENGTH, flag --auth-otp-length. Used by Serve.
    # length:
  # Sender address for auth emails.
  # Env ZP_AUTH_EMAILFROM, flag --auth-emailfrom. Used by Serve, TestEmail, Notify.
  # emailfrom:

  # Static API token.
  # Env ZP_AUTH_TOKEN, flag --auth-token. Used by Serve.
  # token:

  # API keys file.
  # Env ZP_AUTH_KEYS, flag --auth-keys. Used by Serve.
  # keys:

# Outgoing mail
smtp:
  # SMTP server host.
  # Env ZP_SMTP_HOST, flag --smtp-host. Used by Serve, TestEmail, Notify.
  # host:

  # SMTP server port.
  # Env ZP_SMTP_PORT, flag --smtp-port. Used by Serve, TestEmail, Notify.
  # port: 587

  # Use implicit TLS.
  # Env ZP_SMTP_TLS, flag --smtp-tls. Used by Serve, TestEmail, Notify.
  # tls:
