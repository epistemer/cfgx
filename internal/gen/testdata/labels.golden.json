{
  "domain": "labels/v1",
  "labels": [
    {
      "key": "settings.database",
      "path": "database",
      "text": "Database connection",
      "var": "L10nDB"
    },
    {
      "key": "settings.database.host",
      "path": "database.host",
      "text": "Host",
      "var": "L10nDBHost"
    },
    {
      "key": "settings.database.sslmode",
      "path": "database.sslmode",
      "text": "SSL mode, as in \"sslmode=require\"",
      "var": "L10nDBSslmode"
    },
    {
      "key": "settings.database.sslmode.disable",
      "path": "database.sslmode.disable",
      "text": "disable"
    },
    {
      "key": "settings.database.sslmode.verify-full",
      "path": "database.sslmode.verify-full",
      "text": "verify-full"
    },
    {
      "key": "settings.server",
      "path": "server",
      "text": "HTTP server",
      "var": "L10nServer"
    },
    {
      "key": "settings.server.port",
      "path": "server.port",
      "text": "Port",
      "var": "L10nServerPort"
    },
    {
      "key": "settings.server.tls.enabled",
      "path": "server.tls.enabled",
      "text": "Serve HTTPS",
      "var": "L10nServerTLSEnabled"
    },
    {
      "key": "settings.server.tls.cert",
      "path": "server.tls.cert",
      "text": "TLS certificate",
      "var": "L10nServerTLSCert"
    },
    {
      "key": "settings.scheduler",
      "path": "scheduler",
      "text": "Task scheduler",
      "var": "L10nScheduler"
    },
    {
      "key": "settings.scheduler.workers",
      "path": "scheduler.workers",
      "text": "Workers",
      "var": "L10nSchedulerWorkers"
    },
    {
      "key": "settings.scheduler.retry",
      "path": "scheduler.retry",
      "text": "Retry policy",
      "var": "L10nSchedulerRetry"
    },
    {
      "key": "settings.scheduler.retry.max",
      "path": "scheduler.retry.max",
      "text": "Maximum retries",
      "var": "L10nSchedulerRetryMax"
    },
    {
      "key": "settings.auth",
      "path": "auth",
      "text": "Authentication",
      "var": "L10nAuth"
    },
    {
      "key": "settings.auth.otp.length",
      "path": "auth.otp.length",
      "text": "OTP length",
      "var": "L10nAuthOTPLength"
    },
    {
      "key": "settings.auth.emailfrom",
      "path": "auth.emailfrom",
      "text": "Sender address for auth emails",
      "var": "L10nAuthEmailfrom"
    },
    {
      "key": "settings.auth.token",
      "path": "auth.token",
      "text": "Static API token",
      "var": "L10nAuthToken"
    },
    {
      "key": "settings.auth.keys",
      "path": "auth.keys",
      "text": "API keys file",
      "var": "L10nAuthKeys"
    },
    {
      "key": "settings.smtp",
      "path": "smtp",
      "text": "Outgoing mail",
      "var": "L10nSMTP"
    },
    {
      "key": "settings.smtp.host",
      "path": "smtp.host",
      "text": "SMTP server host",
      "var": "L10nSMTPHost"
    },
    {
      "key": "settings.smtp.port",
      "path": "smtp.port",
      "text": "SMTP server port",
      "var": "L10nSMTPPort"
    },
    {
      "key": "settings.smtp.tls",
      "path": "smtp.tls",
      "text": "Use implicit TLS",
      "var": "L10nSMTPTLS"
    }
  ],
  "package": {
    "dir": "internal/settings",
    "name": "settings"
  },
  "producer": "cfgx"
}
