# zp: environment variables.
# Generated by cfgx from the schema; don't edit. Each is commented out at
# its default.

# The config file to read, instead of searching for config.yaml.
# ZP_CONFIG=

# Minimum log level; one of debug, info, warn, error.
# Key log.level, flag --log-level. Used by every command.
# ZP_LOG_LEVEL=info

# Output format; one of text, json.
# Key log.format, flag --log-format. Used by every command.
# ZP_LOG_FORMAT=text

# Force colored output even without a TTY.
# Key log.color, flag --log-color. Used by every command.
# ZP_LOG_COLOR=

# Database server host.
# Key database.host, flag --database-host. Used by Serve, Migrate.
# ZP_DATABASE_HOST=localhost

# Database server port.
# Key database.port, flag --database-port. Used by Serve, Migrate.
# ZP_DATABASE_PORT=5432

# Database name.
# Required.
# Key database.name, flag --database-name. Used by Serve, Migrate.
# ZP_DATABASE_NAME=

# Database user.
# Key database.user, flag --database-user. Used by Serve, Migrate.
# ZP_DATABASE_USER=postgres

# Database password.
# Required. Secret: set it in the environment, not here.
# Key database.password. Used by Serve, Migrate.
# ZP_DATABASE_PASSWORD=

# SSL mode; one of disable, require, verify-full.
# Key database.sslmode, flag --database-sslmode. Used by Serve, Migrate.
# ZP_DATABASE_SSLMODE=disable

# SMTP server host.
# Required.
# Key smtp.host, flag --smtp-host. Used by Serve, TestEmail.
# ZP_SMTP_HOST=

# SMTP server port.
# Key smtp.port, flag --smtp-port. Used by Serve, TestEmail.
# ZP_SMTP_PORT=587

# SMTP user.
# Key smtp.user, flag --smtp-user. Used by Serve, TestEmail.
# ZP_SMTP_USER=

# SMTP password.
# Secret: set it in the environment, not here.
# Key smtp.password. Used by Serve, TestEmail.
# ZP_SMTP_PASSWORD=

# SMTP auth mechanism; one of PLAIN, LOGIN, CRAM-MD5.
# Key smtp.auth, flag --smtp-auth. Used by Serve, TestEmail.
# ZP_SMTP_AUTH=PLAIN

# Use implicit TLS.
# Key smtp.tls, flag --smtp-tls. Used by Serve, TestEmail.
# ZP_SMTP_TLS=

# Sender address for auth emails.
# Key auth.emailfrom, flag --auth-emailfrom. Used by Serve, TestEmail.
# ZP_AUTH_EMAILFROM=

# OTP validity.
# Key auth.otp.ttl, flag --auth-otp-ttl. Used by Serve.
# ZP_AUTH_OTP_TTL=5m0s

# OTP length.
# Key auth.otp.length, flag --auth-otp-length. Used by Serve.
# ZP_AUTH_OTP_LENGTH=6

# Session lifetime.
# Key auth.session.ttl, flag --auth-session-ttl. Used by Serve.
# ZP_AUTH_SESSION_TTL=24h0m0s

# JWT private key (PEM).
# Key auth.jwt.private, flag --auth-jwt-private. Used by Serve.
# ZP_AUTH_JWT_PRIVATE=keys/priv.pem

# JWT public key (PEM).
# Key auth.jwt.public, flag --auth-jwt-public. Used by Serve.
# ZP_AUTH_JWT_PUBLIC=keys/pub.pem

# Static API token.
# Secret: set it in the environment, not here.
# Key auth.token. Used by Serve.
# ZP_AUTH_TOKEN=

# CSV file of API keys.
# Key auth.keys, flag --auth-keys. Used by Serve.
# ZP_AUTH_KEYS=

# Require multi-factor authentication.
# Key auth.mfa, flag --auth-mfa. Used by Serve.
# ZP_AUTH_MFA=

# Listen address.
# Key server.host, flag --host. Used by Serve.
# ZP_SERVER_HOST=0.0.0.0

# Listen port.
# Key server.port, flag --port. Used by Serve.
# ZP_SERVER_PORT=7777

# Serve HTTPS.
# Key server.tls.enabled, flag --tls-enabled. Used by Serve.
# ZP_SERVER_TLS_ENABLED=

# TLS certificate.
# Key server.tls.cert, flag --tls-cert. Used by Serve.
# ZP_SERVER_TLS_CERT=ssl/cert.pem

# TLS private key.
# Key server.tls.key, flag --tls-key. Used by Serve.
# ZP_SERVER_TLS_KEY=ssl/key.pem

# Read timeout.
# Key server.timeout.read, flag --timeout-read. Used by Serve.
# ZP_SERVER_TIMEOUT_READ=20s

# Write timeout.
# Key server.timeout.write, flag --timeout-write. Used by Serve.
# ZP_SERVER_TIMEOUT_WRITE=1m0s

# Maximum request header size.
# Key server.max_header, flag --max-header. Used by Serve.
# ZP_SERVER_MAX_HEADER=1MiB

# Requests per second per IP.
# Key server.rate.limit, flag --rate-limit. Used by Serve.
# ZP_SERVER_RATE_LIMIT=100

# Burst capacity per IP.
# Key server.rate.burst, flag --rate-burst. Used by Serve.
# ZP_SERVER_RATE_BURST=20

# Scheduler timezone.
# Key scheduler.location, flag --scheduler-location. Used by Serve.
# ZP_SCHEDULER_LOCATION=Africa/Cairo

# Task execution mode; one of sequential, parallel.
# Key scheduler.execmode, flag --scheduler-execmode. Used by Serve.
# ZP_SCHEDULER_EXECMODE=sequential

# Concurrent workers.
# Default: from runtime.NumCPU.
# Key scheduler.workers, flag --scheduler-workers. Used by Serve.
# ZP_SCHEDULER_WORKERS=

# Maximum retries.
# Key scheduler.retry.max, flag --scheduler-retry-max. Used by Serve.
# ZP_SCHEDULER_RETRY_MAX=3

# Delay between retries.
# Key scheduler.retry.delay, flag --scheduler-retry-delay. Used by Serve.
# ZP_SCHEDULER_RETRY_DELAY=1m0s

# Bolt database file; also holds runtime settings.
# Key storage.bolt, flag --storage-bolt. Used by no command.
# ZP_STORAGE_BOLT=bolt.db
