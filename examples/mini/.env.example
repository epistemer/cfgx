# mini: environment variables.
# Generated by cfgx from the schema; don't edit. Each is commented out at
# its default.

# The config file to read, instead of searching for mini.yaml.
# MINI_CONFIG=

# Listen host.
# Key server.host, flag --server-host. Used by Serve.
# MINI_SERVER_HOST=localhost

# Listen port.
# Key server.port, flag --server-port. Used by Serve.
# MINI_SERVER_PORT=8080

# Enable TLS.
# Key server.tls, flag --server-tls. Used by Serve.
# MINI_SERVER_TLS=

# Database connection URL.
# Key database.url, flag --database-url. Used by Serve, Migrate.
# MINI_DATABASE_URL=

# Query timeout in seconds.
# Key database.timeout, flag --database-timeout. Used by Serve, Migrate.
# MINI_DATABASE_TIMEOUT=

# Log SQL queries.
# Key database.debug, flag --database-debug. Used by Serve, Migrate.
# MINI_DATABASE_DEBUG=false

# Log more.
# Key log.verbose, flag --log-verbose. Used by every command.
# MINI_LOG_VERBOSE=
